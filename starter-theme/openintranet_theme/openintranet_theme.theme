<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit subtheme.
 */

use Drupal\block_content\BlockContentInterface;
use Drupal\comment\CommentingStatus;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\link\LinkItemInterface;
use Drupal\node\NodeInterface;
use Drupal\user\UserInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_form_system_theme_settings_alter().
 */
function openintranet_theme_form_system_theme_settings_alter(array &$form) {
  $options = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
  $form['components']['navbar']['bootstrap_barrio_navbar_top_background']['#options'] = $options;
  $form['components']['navbar']['bootstrap_barrio_navbar_background']['#options'] = $options;
}

/**
 * Implements hook_form_alter().
 */
function openintranet_theme_form_alter(array &$form) {
  if (isset($form['search_api_fulltext'])) {
    $form['search_api_fulltext']['#attributes']['placeholder'] = t('Search');
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function openintranet_theme_form_user_login_form_alter(array &$form) {
  $form['actions']['#attributes']['class'][] = 'd-flex';
  $form['actions']['#attributes']['class'][] = 'justify-content-center';
  $form['actions']['submit']['#attributes']['class'][] = 'px-5';
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function openintranet_theme_theme_suggestions_views_view_alter(array &$suggestions, array $variables) {
  if (!empty($variables['view']->current_display)) {
    $view_name = $variables['view']->storage->id();
    $display_id = $variables['view']->current_display;
    $suggestions[] = 'views_view__' . $view_name . '__' . $display_id;
    $suggestions[] = 'views_view__' . $view_name;
  }
}

/**
 * Implements hook_views_pre_render().
 */
function openintranet_theme_views_pre_render(ViewExecutable $view) {
  if ($view->id() === 'search_content') {
    $view->setTitle($view->getTitle() . ' (' . $view->total_rows . ')');
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function openintranet_theme_preprocess_block(array &$variables) {
  $entity_type_manager = \Drupal::service('entity_type.manager');
  $renderer = \Drupal::service('renderer');

  // The account menu templates show the current user's name and picture.
  // Vary those blocks per user instead of making them uncacheable: max-age 0
  // bubbled up and disabled the Dynamic Page Cache on every page.
  if (($variables['plugin_id'] ?? NULL) === 'system_menu_block:account') {
    $variables['current_user'] = $entity_type_manager->getStorage('user')
      ->load(\Drupal::currentUser()->id());
    $variables['#cache']['contexts'][] = 'user';
    if ($variables['current_user']) {
      $renderer->addCacheableDependency($variables, $variables['current_user']);
      // Plain strings for the template: on the user edit page the field values
      // of the shared user object are not usable from Twig while the form is
      // built, which left the name empty, and that variant then got cached.
      $account = $variables['current_user'];
      $name_parts = [];
      foreach (['field_first_name', 'field_last_name'] as $field_name) {
        $value = $account->hasField($field_name) ? trim((string) $account->get($field_name)->value) : '';
        if ($value !== '') {
          $name_parts[] = $value;
        }
      }
      $variables['current_user_display_name'] = $name_parts ? implode(' ', $name_parts) : $account->getDisplayName();
      $variables['current_user_has_picture'] = $account->hasField('user_picture') && !$account->get('user_picture')->isEmpty();
    }
  }

  if (!empty($variables['elements']['#id']) && $variables['elements']['#id'] === 'openintranet_theme_knowledge_base_book') {
    $variables['#attached']['library'][] = 'openintranet_theme/search-book';
  }

  // Banner CTA and quick action: give the templates the link URL and title
  // from the field values instead of digging them out of the render array.
  $block_content = $variables['content']['#block_content'] ?? NULL;
  if ($block_content instanceof BlockContentInterface) {
    $renderer->addCacheableDependency($variables, $block_content);
    foreach (['field_banner_cta' => 'banner_cta', 'field_quick_action' => 'quick_action'] as $field_name => $variable) {
      if (!$block_content->hasField($field_name) || $block_content->get($field_name)->isEmpty()) {
        continue;
      }
      $link = $block_content->get($field_name)->first();
      if (!$link instanceof LinkItemInterface) {
        continue;
      }
      $url = $link->getUrl()->toString(TRUE);
      $renderer->addCacheableDependency($variables, $url);
      $variables[$variable] = [
        'url' => $url->getGeneratedUrl(),
        'title' => $link->get('title')->getString() ?: t('See more'),
      ];
    }
  }
}

/**
 * Implements template_preprocess_views_view().
 */
function openintranet_theme_preprocess_views_view(array &$vars) {
  $vars['more']['#options']['attributes']['class'] = ['btn', 'btn-primary', 'w-100'];
}

/**
 * Implements hook_preprocess_node().
 */
function openintranet_theme_preprocess_node(array &$variables) {
  $entity_type_manager = \Drupal::service('entity_type.manager');
  $database = \Drupal::service('database');

  $node = $variables['node'];

  // node.html.twig lists the revision authors with the submitted information
  // only; skip the query for teasers and other displays without it.
  if ($node instanceof NodeInterface && !empty($variables['display_submitted'])) {
    $uids = $database->select('node_revision', 'nr')
      ->fields('nr', ['revision_uid'])
      ->condition('nr.nid', $node->id())
      ->distinct()
      ->execute()
      ->fetchCol();

    // Render arrays, not rendered strings: their cache metadata (the author
    // user entities) then bubbles up with the node instead of being lost.
    $variables['revision_authors'] = [];
    if (!empty($uids)) {
      $users = $entity_type_manager->getStorage('user')->loadMultiple($uids);
      $view_builder = $entity_type_manager->getViewBuilder('user');
      foreach ($users as $user) {
        $variables['revision_authors'][] = $view_builder->view($user, 'compact');
      }
    }
  }

  // Comment counter of the news teaser: shown only when the node's comments
  // are enabled and its full display shows them, so hiding comments in Manage
  // display hides the counter too.
  $variables['comment_count'] = NULL;
  if ($node instanceof NodeInterface) {
    $full_display = EntityViewDisplay::collectRenderDisplay($node, 'full');
    \Drupal::service('renderer')->addCacheableDependency($variables, $full_display);
    foreach ($node->getFieldDefinitions() as $field_name => $definition) {
      if ($definition->getType() !== 'comment' || !$full_display->getComponent($field_name)) {
        continue;
      }
      $comments = $node->get($field_name);
      if ((int) $comments->status !== CommentingStatus::Hidden->value) {
        $variables['comment_count'] = (int) $comments->comment_count;
      }
      break;
    }
  }

  if ($node instanceof NodeInterface) {
    $marked_as_must_read = $node->hasField('field_mark_as_must_read')
      && !$node->get('field_mark_as_must_read')->isEmpty()
      && (bool) $node->get('field_mark_as_must_read')->getString();

    if (!$marked_as_must_read && isset($variables['content']['flag_read'])) {
      $variables['content']['flag_read']['#access'] = FALSE;
    }
  }
}

/**
 * Implements hook_preprocess_HOOK().
 *
 * Render the standard local task tabs (View / Edit / Delete / Revisions ...)
 * near the page content on node and user pages. The placed local_tasks_block
 * is suppressed under the core Navigation top bar, so the tabs are rebuilt here
 * from the block plugin and exposed to page.html.twig.
 */
function openintranet_theme_preprocess_page(array &$variables) {
  $variables['content_local_tasks'] = NULL;
  $variables['account_page'] = NULL;

  $route_match = \Drupal::routeMatch();
  $route_name = $route_match->getRouteName();
  $is_node_page = $route_match->getParameter('node') !== NULL;
  $is_user_page = $route_match->getParameter('user') !== NULL;

  $account_pages = [
    'openintranet_notifications.inbox' => [
      'layout' => 'focused',
      'variant' => 'inbox',
      'title' => t('Notifications'),
      'context' => NULL,
    ],
    'openintranet_notifications.user_preferences' => [
      'layout' => 'focused',
      'variant' => 'preferences',
      'title' => t('Notification preferences'),
      'context' => t('User profile'),
    ],
    'entity.user.edit_form' => [
      'layout' => 'focused',
      'variant' => 'edit',
      'title' => t('Edit profile'),
      'context' => t('User profile'),
    ],
    'entity.user.canonical' => [
      'layout' => 'profile',
      'variant' => 'overview',
      'title' => t('User profile'),
      'context' => t('User profile'),
    ],
  ];

  if (isset($account_pages[$route_name])) {
    $variables['account_page'] = $account_pages[$route_name];

    if ($route_name === 'entity.user.canonical') {
      $user = $route_match->getParameter('user');
      if ($user instanceof UserInterface) {
        $name_parts = [];
        foreach (['field_first_name', 'field_last_name'] as $field_name) {
          if ($user->hasField($field_name) && !$user->get($field_name)->isEmpty()) {
            $name_parts[] = trim((string) $user->get($field_name)->value);
          }
        }
        $variables['account_page']['title'] = $name_parts
          ? implode(' ', $name_parts)
          : $user->getDisplayName();
      }
    }
  }

  if ($is_node_page || $is_user_page) {
    $build = \Drupal::service('plugin.manager.block')
      ->createInstance('local_tasks_block', [])
      ->build();

    // Drupal hides a lone "View" task (or none), which would leave an empty
    // wrapper. Probe a COPY of the render array (renderInIsolation() marks the
    // array it renders as #printed, so render the copy and keep $build clean
    // for Twig) and only expose the tabs when there is something to show. The
    // block runs its own access checks, so the tabs stay permission-aware.
    $probe = $build;
    $rendered = (string) \Drupal::service('renderer')->renderInIsolation($probe);

    if (trim(strip_tags($rendered)) !== '') {
      // Vary by route + permissions so the tabs never leak across pages/users.
      $build['#cache']['contexts'] = Cache::mergeContexts(
        $build['#cache']['contexts'] ?? [],
        ['route', 'user.permissions']
      );
      $variables['content_local_tasks'] = $build;
    }
  }
}

/**
 * Implements hook_preprocess_page_title().
 */
function openintranet_theme_preprocess_page_title(array &$variables) {
  if (\Drupal::routeMatch()->getRouteName() === 'entity.taxonomy_term.canonical') {
    if ($term = \Drupal::routeMatch()->getParameter('taxonomy_term')) {
      $variables['title']['#markup'] = $term->getName();
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for user templates.
 *
 * Gives the user templates the display name, initials and e-mail address as
 * plain values built from the entity, instead of reading formatter
 * internals (#context) or rendered markup in Twig.
 */
function openintranet_theme_preprocess_user(array &$variables) {
  $account = $variables['user'] ?? NULL;
  if (!$account instanceof UserInterface) {
    return;
  }
  $name_parts = [];
  foreach (['field_first_name', 'field_last_name'] as $field_name) {
    $value = $account->hasField($field_name) ? trim((string) $account->get($field_name)->value) : '';
    if ($value !== '') {
      $name_parts[] = $value;
    }
  }
  $display_name = $name_parts ? implode(' ', $name_parts) : (string) $account->getDisplayName();
  $variables['profile_display_name'] = $display_name;
  $initials = implode('', array_map(fn (string $part): string => mb_substr($part, 0, 1), $name_parts));
  $variables['profile_initials'] = mb_strtoupper($initials !== '' ? $initials : mb_substr($display_name, 0, 1));

  // The address is shown only to users who may see it (core's 'view user
  // email addresses' permission, or the account owner).
  $mail_access = $account->get('mail')->access('view', NULL, TRUE);
  \Drupal::service('renderer')->addCacheableDependency($variables, $mail_access);
  $variables['profile_email'] = $mail_access->isAllowed() ? $account->getEmail() : NULL;
}
