{#
/**
 * @file
 * Page layout for user pages.
 *
 * Extends page.html.twig: the header, featured regions and footer are shared.
 * The profile and edit pages render the account page shell like every page;
 * other user pages (shortcuts, submissions, ...) get the profile heading and
 * a content column with an optional sidebar.
 *
 * @see page.html.twig
 * @see openintranet_theme_preprocess_page()
 */
#}
{% extends '@openintranet_theme/layout/page.html.twig' %}

{# Hide sidebars whose blocks render nothing, see
   https://www.drupal.org/project/drupal/issues/953034#comment-14192130 #}
{% set sidebar_first_exists = page.sidebar_first|render|striptags('<img><video><audio><drupal-render-placeholder>')|trim is not empty %}
{% set sidebar_second_exists = page.sidebar_second|render|striptags('<img><video><audio><drupal-render-placeholder>')|trim is not empty %}

{% block content %}
  {% if account_page %}
    {{ parent() }}
  {% else %}
    <div id="main" class="{{ container }}">
      <div id="block-openintranet-theme-page-title" class="contextual-region block block-primary block-core block-page-title-block mb-3 row">
        <div class="content">
          {% if user_profile_context_is_heading %}
            <h1 class="title">{{ 'User profile'|t }}</h1>
          {% else %}
            <p class="title user-profile-context">{{ 'User profile'|t }}</p>
          {% endif %}
        </div>
      </div>
      {% if content_local_tasks %}
        <div class="row">
          <div class="col-md-8">
            <nav class="content-local-tasks" aria-label="{{ 'Local tasks'|t }}">{{ content_local_tasks }}</nav>
          </div>
        </div>
      {% endif %}
      <div class="row row-offcanvas row-offcanvas-left clearfix">
        <div class="block block-background d-flex p-0 flex-column flex-lg-row">
          <main{{ content_attributes }}>
            <section class="section">
              <a href="#main-content" id="main-content" tabindex="-1"></a>
              {{ page.content|without('openintranet_theme_primary_local_tasks') }}
            </section>
          </main>
          {% if sidebar_first_exists %}
            <div{{ sidebar_first_attributes.removeClass('col-md-3').addClass('col-lg-4') }}>
              <aside class="section" role="complementary">
                {{ page.sidebar_first }}
              </aside>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
{% endblock %}
