{%
  set classes = [
  'block',
  'm-0 p-0',
  'me-2',
  'position-relative',
  'block-' ~ configuration.provider|clean_class,
  'block-' ~ plugin_id|clean_class,
]
%}

<div {{ attributes.addClass(classes) }}>
  {% if content %}
    {{ content }}
  {% else %}
    <a href="/notifications">
      <i class="icon--notification" aria-hidden="true"></i>
      <span class="visually-hidden">{{ 'Notifications'|t }}</span>
    </a>
  {% endif %}
</div>
