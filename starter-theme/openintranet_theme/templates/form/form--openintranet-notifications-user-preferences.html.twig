{#
/**
 * @file
 * Theme override for the user notification preferences form.
 */
#}
{{ attach_library('bootstrap_barrio/form') }}
<form{{ attributes }}>
  {% embed 'openintranet_theme:account-panel' with {
    attributes: create_attribute({'class': ['notifications-preferences__panel']}),
    variant: 'stack',
    form_children: children,
  } only %}
    {% block content %}
      {{ form_children }}
    {% endblock %}
  {% endembed %}
</form>
