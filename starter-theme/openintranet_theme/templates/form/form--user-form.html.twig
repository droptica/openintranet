{#
/**
 * @file
 * Theme override for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 */
#}
{{ attach_library('bootstrap_barrio/form') }}
<form{{ attributes.addClass('user-edit-form') }}>
  {% embed 'openintranet_theme:account-panel' with {
    attributes: create_attribute({'class': ['user-edit-form__panel']}),
    variant: 'form',
    form_children: children,
  } only %}
    {% block content %}
      {{ form_children }}
    {% endblock %}
  {% endembed %}
</form>
