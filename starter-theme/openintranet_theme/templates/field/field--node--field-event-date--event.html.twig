{#
/**
 * @file
 * Event date field: a one-day event shows its date once.
 *
 * item.single_day (date, start, end and their datetime attributes) comes from
 * openintranet_theme_preprocess_field() and is set for one-day events only.
 * Events spanning several days print the formatter output.
 */
#}
{%
  set classes = [
    'field',
    'field--name-' ~ field_name|clean_class,
    'field--type-' ~ field_type|clean_class,
    'field--label-' ~ label_display,
  ]
%}
{%
  set title_classes = [
    'field__label',
    label_display == 'visually_hidden' ? 'visually-hidden',
  ]
%}

<div{{ attributes.addClass(classes) }}>
  {% if not label_hidden %}
    <div{{ title_attributes.addClass(title_classes) }}>{{ label }}</div>
  {% endif %}
  <div{{ content_attributes.addClass('field__items') }}>
    {% for item in items %}
      <div{{ item.attributes.addClass('field__item') }}>
        {% if item.single_day %}
          {# One-day event: the date once, then the start and end times. #}
          {{ item.single_day.date }}: <time datetime="{{ item.single_day.start_datetime }}">{{ item.single_day.start }}</time> – <time datetime="{{ item.single_day.end_datetime }}">{{ item.single_day.end }}</time>
        {% else %}
          {{ item.content }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>
