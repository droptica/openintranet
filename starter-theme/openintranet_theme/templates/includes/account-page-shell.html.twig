{#
/**
 * @file
 * Shared account and notification page layout.
 *
 * Required variables:
 * - account_page: Route-derived layout, variant, title, and context values.
 * - container: Bootstrap Barrio container class.
 * - page: Page regions.
 * - content_attributes: Attributes for the main content element.
 * - content_local_tasks: Permission-aware account tabs.
 * - sidebar_first_exists: Whether the first sidebar has visible content.
 * - sidebar_first_attributes: Attributes for the first sidebar.
 */
#}
{% set show_sidebar = account_page.layout == 'profile' and sidebar_first_exists %}
{% set shell_classes = [
  container,
  'account-page',
  'account-page--' ~ account_page.layout,
  'account-page--' ~ account_page.variant,
] %}
{% set main_classes = [
  'account-page__main',
  'col-12',
  show_sidebar ? 'col-lg-8',
] %}

<div id="main" class="{{ shell_classes|join(' ') }}">
  {{ page.breadcrumb }}

  <header class="account-page__header">
    {% if account_page.context %}
      <p class="account-page__context">{{ account_page.context }}</p>
    {% endif %}
    <h1 class="account-page__title">{{ account_page.title }}</h1>
  </header>

  {% if content_local_tasks %}
    <nav class="account-page__tabs content-local-tasks" aria-label="{{ 'Account sections'|t }}">
      {{ content_local_tasks }}
    </nav>
  {% endif %}

  <div class="account-page__body row g-4">
    {% if show_sidebar %}
      <div{{ sidebar_first_attributes.removeClass('col-md-3', 'col-lg-3', 'col-lg-4').addClass('account-page__sidebar', 'col-12', 'col-lg-4') }}>
        <aside class="section" aria-label="{{ 'Profile summary'|t }}">
          {{ page.sidebar_first }}
        </aside>
      </div>
    {% endif %}

    <main{{ content_attributes.removeClass('col', 'col-md-9', 'col-lg-9').addClass(main_classes) }}>
      <section class="section">
        <a href="#main-content" id="main-content" tabindex="-1"></a>
        {% if account_page.layout == 'profile' %}
          {{ page.content|without(
            'openintranet_theme_content',
            'openintranet_theme_page_title',
            'openintranet_theme_primary_local_tasks'
          ) }}
        {% else %}
          {{ page.content|without(
            'openintranet_theme_page_title',
            'openintranet_theme_primary_local_tasks'
          ) }}
        {% endif %}
      </section>
    </main>
  </div>
</div>
