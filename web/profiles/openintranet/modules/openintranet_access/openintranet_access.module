<?php

declare(strict_types=1);

/**
 * @file
 * Provides group-based access control for Open Intranet.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_entity_access().
 */
function openintranet_access_entity_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  // Bypass permission.
  if ($account->hasPermission('bypass openintranet access')) {
    return AccessResult::neutral()->cachePerPermissions();
  }

  // Only check for existing entities.
  if ($entity->isNew()) {
    return AccessResult::neutral();
  }

  /** @var \Drupal\openintranet_access\Service\OiAccessCheckerInterface $checker */
  $checker = \Drupal::service('openintranet_access.checker');

  // First, check plugin-specific access (inheritance, etc.).
  /** @var \Drupal\openintranet_access\Plugin\OiAccessEntity\OiAccessEntityPluginManager $pluginManager */
  $pluginManager = \Drupal::service('plugin.manager.oi_access_entity');
  $plugin = $pluginManager->getPluginForEntity($entity);

  if ($plugin !== NULL) {
    $pluginResult = $plugin->checkAccess($entity, $account, $operation);
    if ($pluginResult === FALSE) {
      return AccessResult::forbidden('Access restricted by Open Intranet Access (inherited).')
        ->addCacheableDependency($entity)
        ->addCacheContexts(['user']);
    }
    // If plugin returns TRUE, we still need to check direct restrictions.
  }

  // Check direct entity restrictions.
  $result = $checker->checkEntityAccess($entity, $account, $operation);

  if ($result === TRUE) {
    return AccessResult::allowed()
      ->addCacheableDependency($entity)
      ->addCacheContexts(['user']);
  }

  if ($result === FALSE) {
    return AccessResult::forbidden('Access restricted by Open Intranet Access.')
      ->addCacheableDependency($entity)
      ->addCacheContexts(['user']);
  }

  return AccessResult::neutral()->addCacheableDependency($entity);
}

/**
 * Implements hook_node_grants().
 */
function openintranet_access_node_grants(AccountInterface $account, string $op): array {
  $grants = [];

  // Bypass permission users get no special grants (they have full access anyway).
  if ($account->hasPermission('bypass openintranet access')) {
    $grants['oi_access_bypass'][] = 1;
    return $grants;
  }

  /** @var \Drupal\openintranet_access\Service\OiGroupManagerInterface $groupManager */
  $groupManager = \Drupal::service('openintranet_access.group_manager');

  // Grant for each user's group (including ancestors!).
  // Important: if user is in "Sales Wroclaw", they must have grant for "Branch Wroclaw" too.
  foreach ($groupManager->getUserGroupsWithAncestors($account) as $group) {
    $grants['oi_access_group'][] = (int) $group->id();
  }

  // Grant for direct UID.
  $grants['oi_access_user'][] = (int) $account->id();

  // Grant for nodes without restrictions.
  $grants['oi_access_public'][] = 0;

  return $grants;
}

/**
 * Implements hook_node_access_records().
 */
function openintranet_access_node_access_records(NodeInterface $node): array {
  $records = [];

  /** @var \Drupal\openintranet_access\Service\OiAccessCheckerInterface $checker */
  $checker = \Drupal::service('openintranet_access.checker');

  if (!$checker->hasRestrictions($node)) {
    // No restrictions - public access.
    $records[] = [
      'realm' => 'oi_access_public',
      'gid' => 0,
      'grant_view' => 1,
      'grant_update' => 0,
      'grant_delete' => 0,
    ];
    return $records;
  }

  // Grants for groups.
  foreach ($checker->getAccessGroups($node) as $group) {
    $records[] = [
      'realm' => 'oi_access_group',
      'gid' => (int) $group->id(),
      'grant_view' => 1,
      'grant_update' => 1,
      'grant_delete' => 1,
    ];
  }

  // Grants for direct users.
  foreach ($checker->getAccessUserIds($node) as $uid) {
    $records[] = [
      'realm' => 'oi_access_user',
      'gid' => $uid,
      'grant_view' => 1,
      'grant_update' => 1,
      'grant_delete' => 1,
    ];
  }

  // Bypass realm for admins.
  $records[] = [
    'realm' => 'oi_access_bypass',
    'gid' => 1,
    'grant_view' => 1,
    'grant_update' => 1,
    'grant_delete' => 1,
  ];

  return $records;
}

/**
 * Implements hook_user_predelete().
 */
function openintranet_access_user_predelete(AccountInterface $account): void {
  // Remove user from all groups when user is deleted.
  /** @var \Drupal\openintranet_access\Service\OiGroupManagerInterface $groupManager */
  $groupManager = \Drupal::service('openintranet_access.group_manager');

  foreach ($groupManager->getUserGroups($account) as $group) {
    $groupManager->removeMember($group, $account);
  }

  // Remove direct user access records.
  \Drupal::database()->delete('oi_access_record')
    ->condition('grant_type', 'user')
    ->condition('target_id', (int) $account->id())
    ->execute();
}

/**
 * Implements hook_ENTITY_TYPE_insert() for oi_group.
 */
function openintranet_access_oi_group_insert(EntityInterface $entity): void {
  /** @var \Drupal\openintranet_access\Entity\OiGroupInterface $entity */
  /** @var \Drupal\openintranet_access\Service\OiAuditLoggerInterface $auditLogger */
  $auditLogger = \Drupal::service('openintranet_access.audit_logger');
  $auditLogger->logGroupCreated($entity);
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for oi_group.
 */
function openintranet_access_oi_group_predelete(EntityInterface $entity): void {
  /** @var \Drupal\openintranet_access\Entity\OiGroupInterface $entity */
  // Audit log before deletion.
  /** @var \Drupal\openintranet_access\Service\OiAuditLoggerInterface $auditLogger */
  $auditLogger = \Drupal::service('openintranet_access.audit_logger');
  $auditLogger->logGroupDeleted($entity);

  // Remove access records for this group.
  \Drupal::database()->delete('oi_access_record')
    ->condition('grant_type', 'group')
    ->condition('target_id', (int) $entity->id())
    ->execute();

  // Remove all memberships for this group.
  \Drupal::database()->delete('oi_group_membership')
    ->condition('group_id', (int) $entity->id())
    ->execute();
}
