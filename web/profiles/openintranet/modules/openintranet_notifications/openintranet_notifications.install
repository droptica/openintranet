<?php

/**
 * @file
 * Install, update and uninstall hooks for Open Intranet Notifications.
 */

declare(strict_types=1);

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * Installs the notification "digested" base field (Stage 6 digests).
 */
function openintranet_notifications_update_10001(): void {
  $field = BaseFieldDefinition::create('timestamp')
    ->setLabel(new TranslatableMarkup('Digested at'))
    ->setDescription(new TranslatableMarkup('When the notification was included in a digest; NULL means not yet digested.'))
    ->setDefaultValue(NULL);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('digested', 'openintranet_notification', 'openintranet_notifications', $field);
}
