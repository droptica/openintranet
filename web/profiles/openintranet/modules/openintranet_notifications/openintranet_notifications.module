<?php

/**
 * @file
 * Open Intranet Notifications module.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function openintranet_notifications_theme(): array {
  return [
    'openintranet_notification_bell' => [
      // The template file is notification-bell.html.twig, not the hook-derived
      // openintranet-notification-bell.html.twig, so name it explicitly.
      'template' => 'notification-bell',
      'variables' => [
        'count' => 0,
        'items' => [],
        'see_all_url' => NULL,
      ],
    ],
    'openintranet_notifications_inbox' => [
      'template' => 'notifications-inbox',
      'variables' => [
        'items' => [],
        'new_count' => 0,
        'preferences_url' => NULL,
        'pager' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_mail().
 *
 * Populates the email_core channel's 'notification' message from the params it
 * passes to MailManagerInterface::mail(); without this the mail body is empty.
 */
function openintranet_notifications_mail(string $key, array &$message, array $params): void {
  if ($key === 'notification') {
    $message['subject'] = $params['subject'];
    $message['body'][] = $params['body'];
  }
}

/**
 * Implements hook_cron().
 *
 * Enforces log retention automatically with a modest per-run cap so a large
 * backlog drains over successive cron runs rather than in one heavy delete,
 * then aggregates pending digest_only notifications into per-user digests.
 *
 * @todo Add a settings flag to disable automatic cron purging if an operator
 *   prefers to run openintranet_notifications:purge manually.
 */
function openintranet_notifications_cron(): void {
  \Drupal::service('openintranet_notifications.retention_purger')->purge(100);
  \Drupal::service('openintranet_notifications.digest_builder')->buildAndDispatch(100);
}

/**
 * Implements hook_gin_ignore_sticky_form_actions().
 *
 * The bulk form's buttons act on the row selection below them, so Gin's sticky
 * top bar puts them far from the table they operate on; keep them inline.
 */
function openintranet_notifications_gin_ignore_sticky_form_actions(): array {
  return ['openintranet_notifications_delivery_bulk'];
}
