<?php

/**
 * @file
 * Open Intranet Notifications module.
 */

declare(strict_types=1);

/**
 * Implements hook_mail().
 *
 * Populates the email_core channel's 'notification' message from the params it
 * passes to MailManagerInterface::mail(); without this the mail body is empty.
 */
function openintranet_notifications_mail(string $key, array &$message, array $params): void {
  if ($key === 'notification') {
    $message['subject'] = $params['subject'];
    $message['body'][] = $params['body'];
  }
}

/**
 * Implements hook_cron().
 *
 * Enforces log retention automatically with a modest per-run cap so a large
 * backlog drains over successive cron runs rather than in one heavy delete.
 *
 * @todo Add a settings flag to disable automatic cron purging if an operator
 *   prefers to run openintranet_notifications:purge manually.
 */
function openintranet_notifications_cron(): void {
  \Drupal::service('openintranet_notifications.retention_purger')->purge(100);
}
