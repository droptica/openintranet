{#
/**
 * @file
 * Compact forum post card for sidebars.
 */
#}
{{ attach_library('openintranet_forum/forum.post') }}
{{ attach_library('openintranet_forum/forum.post-meta') }}
<article{{ attributes.addClass('forum-post', 'forum-post--compact') }}>
  {% block post_meta %}
    <div class="forum-post__meta">
      <div class="forum-post__author">
        <div class="forum-post__avatar">
          {% if forum_post_has_author_picture %}
            {{ forum_post_author_picture }}
          {% else %}
            <span class="forum-post__avatar-placeholder" aria-hidden="true"></span>
          {% endif %}
        </div>
        <a href="{{ forum_post_author_profile_url }}" class="forum-post__author-name">{{ forum_post_author_name }}</a>
      </div>
      <time class="forum-post__date" datetime="{{ forum_post_datetime_attr }}">{{ forum_post_date }}</time>
    </div>
  {% endblock %}

  {% block post_title %}
    {{ title_prefix }}
    <h3 class="forum-post__title forum-post__title--compact">
      <a href="{{ forum_post_url }}" rel="bookmark">{{ label }}</a>
    </h3>
    {{ title_suffix }}
  {% endblock %}

  {% block post_excerpt %}
    {% if forum_post_has_excerpt %}
      <p class="forum-post__excerpt forum-post__excerpt--compact">{{ forum_post_excerpt }}</p>
    {% endif %}
  {% endblock %}

  {% block post_footer %}
    <div class="forum-post__footer">
      {{ include('openintranet_forum:post-meta', {
        nid: node.id(),
        post_url: forum_post_url,
        absolute_url: forum_post_absolute_url,
        icon_base: forum_post_icon_base,
        like_count: forum_post_like_count,
        reply_count: forum_post_reply_count,
        share_count: forum_post_share_count,
        liked: forum_post_user_liked,
        show_share: true,
        size: 'sm',
        actions: forum_post_actions,
      }) }}

      <a href="{{ forum_post_url }}" class="forum-post__reply-link">{{ 'Read post'|t }}</a>
    </div>
  {% endblock %}
</article>
