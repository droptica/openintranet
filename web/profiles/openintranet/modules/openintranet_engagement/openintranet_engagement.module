<?php

/**
 * @file
 * Primary module hooks for User Engagement Analytics module.
 */

declare(strict_types=1);

/**
 * Implements hook_help().
 */
function openintranet_engagement_help(string $route_name): string {
  if ($route_name === 'help.page.openintranet_engagement') {
    $output = '<h2>' . t('User Engagement Analytics') . '</h2>';
    $output .= '<p>' . t('This module tracks and analyzes user engagement using the RFV (Recency, Frequency, Value) scoring model.') . '</p>';
    $output .= '<h3>' . t('Features') . '</h3>';
    $output .= '<ul>';
    $output .= '<li>' . t('<strong>Automatic tracking</strong> - Monitors user activity across content types') . '</li>';
    $output .= '<li>' . t('<strong>User segmentation</strong> - Categorizes users as Champions, Loyal, At Risk, Dormant, New, or Regular') . '</li>';
    $output .= '<li>' . t('<strong>Executive reports</strong> - KPIs, adoption rates, and engagement metrics') . '</li>';
    $output .= '<li>' . t('<strong>Department analysis</strong> - Compare engagement across organizational units') . '</li>';
    $output .= '</ul>';
    $output .= '<p>' . t('Visit <a href=":dashboard">the engagement dashboard</a> to view reports.', [
      ':dashboard' => '/admin/reports/engagement',
    ]) . '</p>';
    return $output;
  }
  return '';
}

