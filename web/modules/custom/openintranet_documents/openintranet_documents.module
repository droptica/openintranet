<?php

declare(strict_types=1);

/**
 * @file
 * Primary module hooks for Open Intranet Documents.
 */

use Drupal\Core\Render\Element;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_help().
 */
function openintranet_documents_help(string $route_name, RouteMatchInterface $route_match): string {
  if ($route_name === 'help.page.openintranet_documents') {
    return '<p>' . t('Provides hierarchical document management with folders.') . '</p>';
  }
  return '';
}

/**
 * Implements hook_theme().
 */
function openintranet_documents_theme(): array {
  return [
    'oi_folder' => [
      'render element' => 'elements',
    ],
    'oi_document' => [
      'render element' => 'elements',
    ],
    'oi_documents_browser' => [
      'variables' => [
        'folders' => [],
        'documents' => [],
        'current_folder' => NULL,
        'breadcrumbs' => [],
        'folder_stats' => [],
      ],
    ],
    'oi_document_view' => [
      'variables' => [
        'document' => NULL,
        'document_id' => NULL,
        'breadcrumbs' => [],
        'file_info' => NULL,
        'file_icon' => '',
        'folder_info' => NULL,
        'author_info' => NULL,
        'created' => '',
        'changed' => '',
      ],
    ],
    'oi_documents_search' => [
      'variables' => [
        'query' => '',
        'results' => [],
        'total' => 0,
        'folder_count' => 0,
        'document_count' => 0,
        'pager' => [],
      ],
    ],
  ];
}

/**
 * Prepares variables for OI Folder templates.
 *
 * Default template: oi-folder.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the folder information.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_oi_folder(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'] ?? 'full';
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Prepares variables for OI Document templates.
 *
 * Default template: oi-document.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the document information.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_oi_document(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'] ?? 'full';
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Implements hook_user_cancel().
 */
function openintranet_documents_user_cancel($edit, UserInterface $account, $method): void {
  switch ($method) {
    case 'user_cancel_block_unpublish':
      // Unpublish documents.
      $storage = \Drupal::entityTypeManager()->getStorage('oi_document');
      $document_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($document_ids) as $document) {
        $document->set('status', FALSE)->save();
      }
      break;

    case 'user_cancel_reassign':
      // Anonymize documents and folders.
      $document_storage = \Drupal::entityTypeManager()->getStorage('oi_document');
      $document_ids = $document_storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($document_storage->loadMultiple($document_ids) as $document) {
        $document->setOwnerId(0)->save();
      }

      $folder_storage = \Drupal::entityTypeManager()->getStorage('oi_folder');
      $folder_ids = $folder_storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($folder_storage->loadMultiple($folder_ids) as $folder) {
        $folder->setOwnerId(0)->save();
      }
      break;
  }
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for user entities.
 */
function openintranet_documents_user_predelete(UserInterface $account): void {
  // Delete documents that belong to this account.
  $document_storage = \Drupal::entityTypeManager()->getStorage('oi_document');
  $document_ids = $document_storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $document_storage->delete(
    $document_storage->loadMultiple($document_ids)
  );
  // Delete old revisions.
  $document_ids = $document_storage->getQuery()
    ->allRevisions()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  foreach (array_keys($document_ids) as $revision_id) {
    $document_storage->deleteRevision($revision_id);
  }

  // Delete folders that belong to this account.
  $folder_storage = \Drupal::entityTypeManager()->getStorage('oi_folder');
  $folder_ids = $folder_storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $folder_storage->delete(
    $folder_storage->loadMultiple($folder_ids)
  );
}
