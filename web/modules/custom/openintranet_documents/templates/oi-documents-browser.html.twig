{#
/**
 * @file
 * Template for the document browser.
 *
 * Available variables:
 * - folders: Array of OiFolder entities (subfolders).
 * - documents: Array of OiDocument entities.
 * - current_folder: Current OiFolder entity or NULL for root.
 * - breadcrumbs: Array of OiFolder entities representing the path.
 * - folder_stats: Array keyed by folder ID with 'folders' and 'documents' counts.
 */
#}
<div class="oi-documents-browser" x-data="documentBrowser">
  {# Breadcrumbs #}
  <nav aria-label="{{ 'Breadcrumb'|t }}" class="oi-breadcrumb-nav mb-4">
    <ol class="breadcrumb mb-0">
      <li class="breadcrumb-item">
        <a href="{{ path('openintranet_documents.browser') }}" class="text-decoration-none">
          <i class="bi bi-folder2 me-1"></i>{{ 'Documents'|t }}
        </a>
      </li>
      {% for folder in breadcrumbs %}
        {% if loop.last %}
          <li class="breadcrumb-item active" aria-current="page">
            <i class="bi bi-folder2-open me-1"></i>{{ folder.getName() }}
          </li>
        {% else %}
          <li class="breadcrumb-item">
            <a href="{{ path('openintranet_documents.folder.view', {'oi_folder': folder.id()}) }}" class="text-decoration-none">
              <i class="bi bi-folder2 me-1"></i>{{ folder.getName() }}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  </nav>

  {# Toolbar: Actions + Search + View Toggle #}
  <div class="oi-documents-toolbar">
    {# Action buttons - using modal dialogs #}
    <div class="oi-documents-actions">
      {% if current_folder %}
        <a href="{{ path('entity.oi_folder.add_modal_in_folder', {'parent': current_folder.id()}) }}"
           class="btn btn-secondary use-ajax"
           data-dialog-type="modal"
           data-dialog-options='{"width": 600, "title": "{{ 'Add subfolder'|t }}"}'>
          <i class="bi bi-folder-plus me-1"></i>{{ 'Add subfolder'|t }}
        </a>
        <a href="{{ path('entity.oi_document.add_modal_in_folder', {'folder': current_folder.id()}) }}"
           class="btn btn-primary use-ajax"
           data-dialog-type="modal"
           data-dialog-options='{"width": 700, "title": "{{ 'Upload document'|t }}"}'>
          <i class="bi bi-file-earmark-plus me-1"></i>{{ 'Upload document'|t }}
        </a>
      {% else %}
        <a href="{{ path('entity.oi_folder.add_modal') }}"
           class="btn btn-secondary use-ajax"
           data-dialog-type="modal"
           data-dialog-options='{"width": 600, "title": "{{ 'Add folder'|t }}"}'>
          <i class="bi bi-folder-plus me-1"></i>{{ 'Add folder'|t }}
        </a>
        <a href="{{ path('entity.oi_document.add_modal') }}"
           class="btn btn-primary use-ajax"
           data-dialog-type="modal"
           data-dialog-options='{"width": 700, "title": "{{ 'Upload document'|t }}"}'>
          <i class="bi bi-file-earmark-plus me-1"></i>{{ 'Upload document'|t }}
        </a>
      {% endif %}
    </div>

    {# Search form #}
    <form action="{{ path('openintranet_documents.search') }}" method="get" class="oi-documents-search-form">
      <div class="input-group">
        <input type="text"
               name="q"
               class="form-control form-control-sm"
               placeholder="{{ 'Search...'|t }}"
               aria-label="{{ 'Search documents'|t }}">
        <button type="submit" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-search"></i>
        </button>
      </div>
    </form>

    {# View toggle #}
    <div class="oi-documents-view-toggle" role="group" aria-label="{{ 'View mode'|t }}">
      <button type="button"
              class="btn btn-outline-secondary"
              :class="{ 'active': isListView() }"
              @click="setView('list')"
              :aria-pressed="isListView()"
              title="{{ 'List view'|t }}">
        ☰
      </button>
      <button type="button"
              class="btn btn-outline-secondary"
              :class="{ 'active': isGridView() }"
              @click="setView('grid')"
              :aria-pressed="isGridView()"
              title="{{ 'Grid view'|t }}">
        ▦
      </button>
    </div>
  </div>

  {# Content area - Folders and Documents #}
  <div class="oi-documents-content" :class="{ 'oi-view-list': isListView(), 'oi-view-grid': isGridView() }">

    {# Folders #}
    {% if folders|length > 0 %}
      <div class="oi-documents-folders">
        <h3>{{ 'Folders'|t }}</h3>

        {# Grid view for folders #}
        <div class="oi-folder-grid" x-show="isGridView()">
          {% for folder in folders %}
            <div class="oi-folder-card">
              <a href="{{ path('openintranet_documents.folder.view', {'oi_folder': folder.id()}) }}" class="oi-folder-link">
                <span class="oi-folder-icon">📁</span>
                <span class="oi-folder-name">{{ folder.getName() }}</span>
              </a>
              <div class="oi-folder-actions">
                <a href="{{ path('entity.oi_folder.edit_form', {'oi_folder': folder.id()}) }}" title="{{ 'Edit'|t }}">✏️</a>
              </div>
            </div>
          {% endfor %}
        </div>

        {# List view for folders - table #}
        <table class="table oi-folders-table" x-show="isListView()">
          <thead>
            <tr>
              <th>{{ 'Name'|t }}</th>
              <th>{{ 'Contents'|t }}</th>
              <th>{{ 'Updated'|t }}</th>
              <th>{{ 'Actions'|t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for folder in folders %}
              {% set stats = folder_stats[folder.id()] ?? {'folders': 0, 'documents': 0} %}
              <tr>
                <td>
                  <a href="{{ path('openintranet_documents.folder.view', {'oi_folder': folder.id()}) }}">
                    📁 {{ folder.getName() }}
                  </a>
                </td>
                <td class="oi-folder-contents">
                  {% if stats.folders > 0 or stats.documents > 0 %}
                    {% if stats.folders > 0 %}
                      <span class="oi-count-folders" title="{{ 'Subfolders'|t }}">📁 {{ stats.folders }}</span>
                    {% endif %}
                    {% if stats.documents > 0 %}
                      <span class="oi-count-documents" title="{{ 'Documents'|t }}">📄 {{ stats.documents }}</span>
                    {% endif %}
                  {% else %}
                    <span class="oi-folder-empty">{{ 'Empty'|t }}</span>
                  {% endif %}
                </td>
                <td>
                  {{ folder.getChangedTime()|date('Y-m-d') }}
                </td>
                <td class="oi-folder-actions">
                  <a href="{{ path('entity.oi_folder.edit_form', {'oi_folder': folder.id()}) }}" class="btn btn-sm btn-outline-secondary" title="{{ 'Edit'|t }}">
                    ✏️
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}

    {# Documents #}
    {% if documents|length > 0 %}
      <div class="oi-documents-list">
        <h3>{{ 'Documents'|t }}</h3>

        {# Grid view for documents #}
        <div class="oi-document-grid" x-show="isGridView()">
          {% for document in documents %}
            {% set file = document.getFile() %}
            <div class="oi-document-card">
              <a href="{{ path('entity.oi_document.canonical', {'oi_document': document.id()}) }}" class="oi-document-link">
                <span class="oi-document-icon">📄</span>
                <span class="oi-document-title">{{ document.getTitle() }}</span>
                {% if file %}
                  <span class="oi-document-filename">{{ file.getFilename() }}</span>
                {% endif %}
              </a>
              <div class="oi-document-actions">
                <a href="{{ path('openintranet_documents.download', {'oi_document': document.id()}) }}" title="{{ 'Download'|t }}">⬇️</a>
                <a href="{{ path('entity.oi_document.edit_form', {'oi_document': document.id()}) }}" title="{{ 'Edit'|t }}">✏️</a>
              </div>
            </div>
          {% endfor %}
        </div>

        {# List view for documents - table #}
        <table class="table oi-documents-table" x-show="isListView()">
          <thead>
            <tr>
              <th>{{ 'Title'|t }}</th>
              <th>{{ 'File'|t }}</th>
              <th>{{ 'Updated'|t }}</th>
              <th>{{ 'Actions'|t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for document in documents %}
              <tr>
                <td>
                  <a href="{{ path('entity.oi_document.canonical', {'oi_document': document.id()}) }}">
                    📄 {{ document.getTitle() }}
                  </a>
                </td>
                <td>
                  {% set file = document.getFile() %}
                  {% if file %}
                    {{ file.getFilename() }}
                  {% else %}
                    -
                  {% endif %}
                </td>
                <td>
                  {{ document.getChangedTime()|date('Y-m-d H:i') }}
                </td>
                <td class="oi-document-actions">
                  <a href="{{ path('openintranet_documents.download', {'oi_document': document.id()}) }}" class="btn btn-sm btn-outline-secondary" title="{{ 'Download'|t }}">
                    ⬇️
                  </a>
                  <a href="{{ path('entity.oi_document.edit_form', {'oi_document': document.id()}) }}" class="btn btn-sm btn-outline-secondary" title="{{ 'Edit'|t }}">
                    ✏️
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>

  {# Empty state #}
  {% if folders|length == 0 and documents|length == 0 %}
    <div class="oi-documents-empty">
      <p>{{ 'No folders or documents in this location.'|t }}</p>
    </div>
  {% endif %}
</div>
