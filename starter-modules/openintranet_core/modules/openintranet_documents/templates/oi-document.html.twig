{#
/**
 * @file
 * Default template for OI Document entity.
 *
 * Available variables:
 * - content: Rendered content fields.
 * - attributes: HTML attributes for the container.
 * - view_mode: The view mode.
 */
#}
<article{{ attributes.addClass('oi-document') }}>
  {% if view_mode != 'full' %}
    {{ title_prefix }}
    {{ title_suffix }}
  {% endif %}
  {% if content %}
    <div class="oi-document__content">
      {{- content -}}
    </div>
  {% endif %}
</article>
